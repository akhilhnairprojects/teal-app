{
  "expo": {
    "name": "Teal",
    "slug": "teal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anair.teal"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B4F4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "name": "Teal",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Teal uses your location to find the closest T stops and Bluebikes stations, and to record your runs and Bluebike rides while Teal is open."
        }
      ]
    ],
    "scheme": "teal",
    "experiments": {
      "typedRoutes": true
    }
  }
}
